{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "舆情洞察",
  "version": "0.1.0",
  "identifier": "com.publicopinion.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "舆情洞察",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "舆情洞察",
    "copyright": "© 2026 舆情洞察",
    "shortDescription": "实时舆情分析与监测平台",
    "longDescription": "面向研究、政企和媒体团队的本地舆情采集、情感分析与可视化看板。",
    "category": "Productivity",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
